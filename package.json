{
  "name": "kaio-qa-portfolio-playwright-ai-testing",
  "version": "1.0.0",
  "description": "AI-powered Playwright test automation framework using Groq AI for selector generation, test data creation, failure analysis, visual validation, and self-healing tests.",
  "author": "Kaio Garcia <kaioqa@protonmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qakaio/Kaio-QA-portfolio-playwright-AI-testing.git"
  },
  "homepage": "https://github.com/qakaio/Kaio-QA-portfolio-playwright-AI-testing",
  "bugs": {
    "url": "https://github.com/qakaio/Kaio-QA-portfolio-playwright-AI-testing/issues"
  },
  "keywords": [
    "playwright",
    "ai-testing",
    "groq",
    "llm",
    "test-automation",
    "self-healing",
    "ai-selectors",
    "pytest",
    "allure-report"
  ],
  "scripts": {
    "test": "python -m pytest -v",
    "test:headed": "python -m pytest --headed",
    "test:ai": "python -m pytest tests/test_ai_features_showcase.py -v -s",
    "test:login": "python -m pytest tests/test_saucedemo_login.py -v -s",
    "test:shopping": "python -m pytest tests/test_saucedemo_shopping.py -v -s",
    "test:failure": "python -m pytest tests/test_example.py::TestExampleSuite::test_intentional_failure_for_ai_analysis -v -s",
    "test:allure": "python -m pytest -v --alluredir=allure-results --clean-alluredir",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "install:browsers": "python -m playwright install chromium",
    "lint": "python -m ruff check .",
    "lint:fix": "python -m ruff check . --fix",
    "typecheck": "python -m mypy ."
  },
  "private": true,
  "devDependencies": {},
  "engines": {
    "python": ">=3.11.0"
  }
}